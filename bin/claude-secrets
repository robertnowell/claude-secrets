#!/usr/bin/env bash
# claude-secrets — plugin entry-point wrapper.
# Resolves the plugin's venv and execs the Python entrypoint.
set -euo pipefail

# When invoked by Claude Code via plugin, these are set. When invoked
# manually from a terminal, fall back to default locations.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/plugins/data/claude-secrets}"

VENV_PY="$PLUGIN_DATA/venv/bin/python"

if [ ! -x "$VENV_PY" ]; then
  echo '{"status":"error","error":"venv not found at '"$VENV_PY"'. Restart Claude Code to let SessionStart hook install dependencies, or run pipeline/requirements.txt install manually."}' >&2
  exit 1
fi

exec "$VENV_PY" -m pipeline.claude_secrets "$@"
